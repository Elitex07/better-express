{
  "name": "bareweb",
  "version": "1.0.0",
  "description": "A high-performance, optimized, and lightweight web server framework for Node.js",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node examples/basic-server.js",
    "test": "node --test test/*.test.js",
    "benchmark": "node benchmarks/compare.js",
    "typecheck": "tsc -p test/types"
  },
  "keywords": [
    "web",
    "server",
    "framework",
    "fast",
    "lightweight",
    "express-alternative",
    "radix-tree"
  ],
  "author": "BareWeb Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "autocannon": "^8.0.0",
    "express": "^4.21.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
